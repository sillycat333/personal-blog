---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../ui/PageHeader.astro";
import type { Post } from "../../types";

const allPosts = Object.values(
  import.meta.glob<Post>("../blog/*.md", { eager: true }),
);
const tags = [
  ...new Set(allPosts.map((post) => post.frontmatter.tags).flat()),
].sort();

const pageTitle = "tags";
---

<BaseLayout pageTitle={pageTitle}>
  <PageHeader
    eyebrow="~/tags"
    title="tags"
    description="Topics I've written about."
  />

  <ul class="flex flex-wrap gap-3 font-mono text-sm">
    {
      tags.map((tag) => (
        <li>
          <a
            class="block border border-neutral-800 px-3 py-1.5 text-neutral-400 hover:border-neutral-500 hover:text-neutral-100"
            href={`/tags/${tag}`}
          >
            #{tag}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
