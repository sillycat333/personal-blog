---
interface Props {
  url: string;
  title: string;
  pubDate: string;
  description: string;
}

const { url, title, pubDate, description } = Astro.props;
---

<li class="h-full">
  <a
    href={url}
    class="group flex h-full flex-col border border-neutral-800 bg-neutral-900/50 p-6 hover:border-neutral-500 hover:bg-neutral-900"
  >
    <h3
      class="font-mono text-lg font-bold text-neutral-100 decoration-neutral-500 underline-offset-4 group-hover:underline"
    >
      {title}
    </h3>

    <p class="mt-2 grow font-sans text-sm leading-relaxed text-neutral-400">
      {description}
    </p>

    <time class="mt-4 block font-mono text-xs text-neutral-400">
      {pubDate}
    </time>
  </a>
</li>
