---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mb-10">
  {eyebrow && <p class="font-mono text-xs text-neutral-400">{eyebrow}</p>}
  <h1
    class="mt-2 font-mono text-3xl font-bold tracking-tight text-neutral-100 sm:text-4xl"
  >
    {title}
  </h1>
  {description && <p class="mt-3 max-w-2xl text-neutral-400">{description}</p>}
  <slot />
</header>
