---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
interface Props {
  pageTitle: string;
  pageDesc?: string;
}

const { pageTitle, pageDesc = "personal site and blog by rid." } = Astro.props;

const siteName = "rid's site";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle} | {siteName}</title>
  </head>
  <body class="bg-neutral-950 font-sans text-neutral-300 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:px-4 focus:py-2 focus:top-4 focus:left-4 focus:bg-neutral-100 focus:text-neutral-950"
    >
      Skip to content
    </a>

    <div class="flex min-h-dvh flex-col">
      <Navbar />

      <main
        id="main-content"
        class="mx-auto w-full max-w-5xl grow px-4 py-12 sm:px-6 lg:px-8"
      >
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
