---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../ui/PageHeader.astro";

const { frontmatter } = Astro.props;

const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString(
  "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="mx-auto max-w-3xl">
    <PageHeader eyebrow="~/blog" title={frontmatter.title}>
      <div
        class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-neutral-400"
      >
        <span>By {frontmatter.author}</span>
        <span class="text-neutral-600">&bull;</span>
        <time datetime={frontmatter.pubDate}>{formattedDate}</time>
      </div>
    </PageHeader>

    <div
      class="prose prose-invert prose-neutral max-w-none prose-headings:font-mono prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-neutral-100 prose-p:text-neutral-300 prose-li:text-neutral-300 prose-strong:text-neutral-100 prose-a:text-neutral-100 prose-a:underline prose-a:underline-offset-4 prose-code:font-mono prose-code:text-neutral-200 prose-pre:border prose-pre:border-neutral-800 prose-pre:bg-neutral-900"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
